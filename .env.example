MCP_HOST=0.0.0.0
MCP_PORT=4010
GAS_UP_API_BASE_URL=http://127.0.0.1:4000

# Optional server-side fallback API key for trusted private deployments.
# For public self-hosted deployments, leave this empty unless your own backend
# controls all traffic to the MCP server. If it is empty, callers must provide
# their own API key for write tools that require backend API-key authorization.
# Callers can pass an API key per request with:
# X-API-Key: gs_live_...
# or Authorization: Bearer gs_live_...
GAS_UP_API_KEY=
